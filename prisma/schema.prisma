generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
   ADMIN
   DRIVER
}
enum LoyaltyType {
  EARNED
  REDEEMED
  ADJUSTED
  EXPIRED
}
enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
  RETURNED
}
enum DiscountType {
  PERCENTAGE
  FIXED
}

enum ShippingCarrier {
  FEDEX
  UPS
  NEXTSHOP_DELIVERY
  OTHER
}

// ─────────────────────────────────────────────
// Auth
// ─────────────────────────────────────────────

model User {
  id         String   @id @default(cuid())
  email      String   @unique
  password   String
  name       String?
  role       Role     @default(ADMIN)
  deliveries Order[]  @relation("DriverOrders")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("users")
}

// ─────────────────────────────────────────────
// Catalogue
// ─────────────────────────────────────────────

model Category {
  id          String     @id @default(cuid())
  name        String     @unique
  slug        String     @unique
  description String?
  image       String?
  imageUrl    String?

  // ── Hierarchy ──────────────────────────────
  // parentId is null for top-level categories (e.g. "Shoes", "Clothes").
  // Sub-categories (e.g. "Men", "Women", "Kids") set parentId to their parent.
  parentId    String?
  parent      Category?  @relation("SubCategories", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("SubCategories")
  // ───────────────────────────────────────────

  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([parentId])
  @@map("categories")
}

model Product {
  id          String         @id @default(cuid())
  name        String
  slug        String         @unique
  description String?
  brand       String?
  price       Int
  compareAt   Int?
  stock       Int            @default(0)
  images      String[]
  published   Boolean        @default(false)
  featured    Boolean        @default(false)
  reviews     ProductReview[]
  categoryId  String?
  category    Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants    ProductVariant[]
  orderItems  OrderItem[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  wishlists   Wishlist[]
  cartItems   CartItem[]
  bundledIn   ProductBundle[] @relation("BundleParent")
  bundleItems ProductBundle[] @relation("BundleChild")

  @@index([slug])
  @@index([categoryId])
  @@index([published])
  @@map("products")
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  color     String?
  size      String?
  sku       String?  @unique
  price     Int?
  stock     Int      @default(0)
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orderItems OrderItem[]
  cartItems  CartItem[]

  @@unique([productId, color, size])
  @@index([productId])
  @@map("product_variants")
}

// ─────────────────────────────────────────────
// Orders
// ─────────────────────────────────────────────

model Order {
  id                  String           @id @default(cuid())
  status              OrderStatus      @default(PENDING)
  stripeSessionId     String?          @unique
  stripePaymentIntent String?          @unique
  subtotal            Int
  shippingCost        Int              @default(0)
  tax                 Int              @default(0)
  discount            Int              @default(0)
  total               Int
  customerEmail       String
  customerName        String?
  shippingAddress     Json?
  discountCode        String?
  items               OrderItem[]
  statusHistory       OrderStatusHistory[]
  driverId            String?
  driver              User?            @relation("DriverOrders", fields: [driverId], references: [id], onDelete: SetNull)
  carrier             ShippingCarrier?
  carrierCompanyName  String?
  trackingNumber      String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([status])
  @@index([customerEmail])
  @@index([stripeSessionId])
  @@index([driverId])
  @@index([carrier])
  @@map("orders")
}

model OrderItem {
  id           String          @id @default(cuid())
  quantity     Int
  unitPrice    Int
  total        Int
  orderId      String
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  productName  String
  productSlug  String
  variantId    String?
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  variantLabel String?

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@map("order_items")
}

// ─────────────────────────────────────────────
// Discounts
// ─────────────────────────────────────────────

model DiscountCode {
  id            String       @id @default(cuid())
  code          String       @unique
  type          DiscountType @default(PERCENTAGE)
  value         Int
  minOrderValue Int?
  maxUses       Int?
  usedCount     Int          @default(0)
  active        Boolean      @default(true)
  expiresAt     DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([code])
  @@map("discount_codes")
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  @@index([orderId])
  @@map("order_status_history")
}

model ProductReview {
  id               String   @id @default(cuid())
  productId        String
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating           Int
  title            String?
  body             String
  authorName       String
  authorEmail      String
  approved         Boolean  @default(false)
  verifiedPurchase Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([productId])
  @@index([approved])
  @@map("product_reviews")
}

model Customer {
  id                  String               @id @default(cuid())
  email               String               @unique
  password            String
  name                String?
  phone               String?
  loyaltyAccount      LoyaltyAccount?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  addresses           CustomerAddress[]
  sessions            CustomerSession[]
  cart                Cart?
  passwordResetTokens PasswordResetToken[]
  wishlists           Wishlist[]

  @@map("customers")
}

model CustomerAddress {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name       String
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([customerId])
  @@map("customer_addresses")
}

model CustomerSession {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  token      String   @unique @default(cuid())
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([token])
  @@index([customerId])
  @@map("customer_sessions")
}

model NewsletterSubscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  subscribedAt DateTime @default(now())
  active       Boolean  @default(true)
}

model Wishlist {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([customerId, productId])
  @@index([customerId])
  @@map("wishlists")
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String?
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
  @@map("faqs")
}

model LoyaltyAccount {
  id         String           @id @default(cuid())
  customerId String           @unique
  customer   Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  points     Int              @default(0)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  history    LoyaltyHistory[]

  @@map("loyalty_accounts")
}

model LoyaltyHistory {
  id          String         @id @default(cuid())
  accountId   String
  account     LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  points      Int
  type        LoyaltyType
  description String
  orderId     String?
  createdAt   DateTime       @default(now())

  @@index([accountId])
  @@map("loyalty_history")
}

model GiftCard {
  id             String          @id @default(cuid())
  code           String          @unique
  initialValue   Int
  balance        Int
  isActive       Boolean         @default(true)
  expiresAt      DateTime
  purchaserEmail String?
  recipientEmail String?
  note           String?
  usages         GiftCardUsage[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([code])
  @@map("gift_cards")
}

model GiftCardUsage {
  id         String   @id @default(cuid())
  giftCardId String
  giftCard   GiftCard @relation(fields: [giftCardId], references: [id], onDelete: Cascade)
  orderId    String?
  amount     Int
  usedAt     DateTime @default(now())

  @@index([giftCardId])
  @@map("gift_card_usages")
}

model Cart {
  id             String     @id @default(cuid())
  customerId     String     @unique
  customer       Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items          CartItem[]
  reminderSentAt DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([customerId])
  @@index([updatedAt])
  @@map("carts")
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int            @default(1)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([cartId, variantId])
  @@index([cartId])
  @@map("cart_items")
}

model ProductBundle {
  id               String   @id @default(cuid())
  productId        String
  product          Product  @relation("BundleParent", fields: [productId], references: [id], onDelete: Cascade)
  bundledProductId String
  bundledProduct   Product  @relation("BundleChild", fields: [bundledProductId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())

  @@unique([productId, bundledProductId])
  @@index([productId])
  @@map("product_bundles")
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  token      String    @unique @default(cuid())
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([token])
  @@index([customerId])
  @@map("password_reset_tokens")
}
