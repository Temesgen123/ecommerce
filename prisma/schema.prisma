generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
}
enum LoyaltyType {
  EARNED
  REDEEMED
  ADJUSTED
  EXPIRED
}
enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}
enum DiscountType {
  PERCENTAGE
  FIXED
}
// ─────────────────────────────────────────────
// Auth
// ─────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// ─────────────────────────────────────────────
// Catalogue
// ─────────────────────────────────────────────

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  imageUrl    String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("categories")
}

model Product {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String?
  price       Int
  compareAt   Int?
  stock       Int         @default(0)
  images      String[]
  published   Boolean     @default(false)
  featured    Boolean     @default(false)
  reviews     ProductReview[]
  categoryId  String?
  category    Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  wishlists Wishlist[]

  @@index([slug])
  @@index([categoryId])
  @@index([published])
  @@map("products")
}

// ─────────────────────────────────────────────
// Orders
// ─────────────────────────────────────────────

model Order {
  id                  String      @id @default(cuid())
  status              OrderStatus @default(PENDING)
  stripeSessionId     String?     @unique
  stripePaymentIntent String?     @unique
  subtotal            Int
  shippingCost        Int         @default(0)
  tax                 Int         @default(0)
  discount            Int         @default(0)
  total               Int
  customerEmail       String
  customerName        String?
  shippingAddress     Json?
  discountCode        String?     // code string snapshot at purchase time
  items               OrderItem[]
  statusHistory OrderStatusHistory[]
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([status])
  @@index([customerEmail])
  @@index([stripeSessionId])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(cuid())
  quantity    Int
  unitPrice   Int
  total       Int
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  productName String
  productSlug String

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// ─────────────────────────────────────────────
// Discounts
// ─────────────────────────────────────────────

model DiscountCode {
  id            String       @id @default(cuid())
  code          String       @unique
  type          DiscountType @default(PERCENTAGE)
  value         Int          // percentage (0–100) or fixed amount in cents
  minOrderValue Int?         // minimum cart total in cents, optional
  maxUses       Int?         // null = unlimited uses
  usedCount     Int          @default(0)
  active        Boolean      @default(true)
  expiresAt     DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([code])
  @@map("discount_codes")
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  @@index([orderId])
  @@map("order_status_history")
}

model ProductReview {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating      Int
  title       String?
  body        String
  authorName  String
  authorEmail String
  approved    Boolean  @default(false)
  createdAt   DateTime @default(now())
  verifiedPurchase Boolean @default(false)
  updatedAt   DateTime @updatedAt
  @@index([productId])
  @@index([approved])
  @@map("product_reviews")
}

model Customer {
  id        String            @id @default(cuid())
  email     String            @unique
  password  String
  name      String?
  phone     String?
  loyaltyAccount LoyaltyAccount?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  addresses CustomerAddress[]
  sessions  CustomerSession[]
  @@map("customers")
  wishlists Wishlist[]
}

model CustomerAddress {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name       String
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([customerId])
  @@map("customer_addresses")
}

model CustomerSession {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  token      String   @unique @default(cuid())
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  @@index([token])
  @@index([customerId])
  @@map("customer_sessions")
}

model NewsletterSubscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  subscribedAt DateTime @default(now())
  active       Boolean  @default(true)
}

model Wishlist {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([customerId, productId])
  @@index([customerId])
  @@map("wishlists")
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String?
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
  @@map("faqs")
}

model LoyaltyAccount {
  id         String          @id @default(cuid())
  customerId String          @unique
  customer   Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  points     Int             @default(0)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  history    LoyaltyHistory[]

  @@map("loyalty_accounts")
}

model LoyaltyHistory {
  id         String         @id @default(cuid())
  accountId  String
  account    LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  points     Int            // positive = earned, negative = spent
  type       LoyaltyType
  description String
  orderId    String?
  createdAt  DateTime       @default(now())

  @@index([accountId])
  @@map("loyalty_history")
}

model GiftCard {
  id            String         @id @default(cuid())
  code          String         @unique
  initialValue  Int            // in cents
  balance       Int            // in cents
  isActive      Boolean        @default(true)
  expiresAt     DateTime
  purchaserEmail String?
  recipientEmail String?
  note          String?
  usages        GiftCardUsage[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([code])
  @@map("gift_cards")
}

model GiftCardUsage {
  id         String   @id @default(cuid())
  giftCardId String
  giftCard   GiftCard @relation(fields: [giftCardId], references: [id], onDelete: Cascade)
  orderId    String?
  amount     Int      // in cents, amount deducted
  usedAt     DateTime @default(now())

  @@index([giftCardId])
  @@map("gift_card_usages")
}